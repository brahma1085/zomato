# ==========================================
# AWS Deployment Environment Configuration
# ==========================================

# AWS Account & Region Settings
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

# Active Spring Profile for AWS
SPRING_PROFILES_ACTIVE=aws

# Frontend (Vercel) & Public Gateway URLs
FRONTEND_URL=http://localhost:4200
PUBLIC_ALB_DOMAIN=http://<YOUR_AWS_ALB_DNS_NAME>
KEYCLOAK_ISSUER_URI=http://<YOUR_AWS_ALB_DNS_NAME>/realms/zomato-realm

# Service Discovery (Netflix Eureka on ECS)
EUREKA_URL=http://discovery-server:8761/eureka/

# RDS PostgreSQL Configuration
DB_HOST=zomato-rds.c123456789.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=YourSecurePassword123!

# Amazon OpenSearch Service Configuration
SEARCH_ENDPOINT=https://search-zomato-opensearch.ap-south-1.es.amazonaws.com:443
SEARCH_USERNAME=opensearch_admin
SEARCH_PASSWORD=YourOpenSearchPassword123!

# External API Keys (Stored in AWS Secrets Manager)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
MAP_API_KEY=AIzaSy_your_google_maps_key_here
